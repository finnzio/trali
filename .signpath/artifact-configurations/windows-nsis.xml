<?xml version="1.0" encoding="utf-8"?>
<!--
  Paste this as the SignPath artifact configuration with slug windows-nsis.
  GitHub Actions upload-artifact stores a ZIP, so zip-file is the root.
  Product name and version restrictions are also enforced in the SignPath dashboard.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
